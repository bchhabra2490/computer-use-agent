# Optional overlay for: python orchestrator.py --auto --pi --env .env.pi
# Same keys as .env. --pi hides computer-use and serves chat in the browser.

OPENAI_API_KEY=

CHAT_OVERLAY=1
CHAT_BROWSER=1
CHAT_BRIDGE_HOST=0.0.0.0
COMPUTER_USE=0
PHONE_GATEWAY=1
