# Copy to .env and fill in secrets:
#   cp .env.example .env
#
# Load into your shell before running, or rely on auto-load from `.env`
# (orchestrator.py / agent.py call load_dotenv on startup):
#   set -a && source .env && set +a
#   python orchestrator.py --auto

# =============================================================================
# Required
# =============================================================================
OPENAI_API_KEY=sk-...
# Required for chat DeepSeek toggle / CHAT_BACKEND=deepseek
# DEEPSEEK_API_KEY=sk-...
# Required when STT_PROVIDER=sarvam
# SARVAM_API_KEY=sk_...

# Cap OpenBLAS/OpenMP threads (avoids rare macOS numpy SIGSEGV on startup).
# OPENBLAS_NUM_THREADS=1
# OMP_NUM_THREADS=1

# =============================================================================
# Models — orchestrator / computer agent / evaluator
# =============================================================================
# Voice router LLM
ORCHESTRATOR_MODEL=gpt-5-mini
# Keep last N computer tasks verbatim; older tasks are LLM-summarized into context.
# ORCHESTRATOR_TASK_HISTORY_KEEP=3
# Summarize the Responses API thread after this many user rounds (resets previous_response_id).
# ORCHESTRATOR_TURN_COMPACT=25
# Optional cheaper model for compaction summaries (defaults to ORCHESTRATOR_MODEL).
# ORCHESTRATOR_COMPACT_MODEL=gpt-5-mini
# Attach live desktop context to each orchestrator question (display + AX + screenshot).
# ORCHESTRATOR_DESKTOP_CONTEXT=1
# ORCHESTRATOR_DESKTOP_SCREENSHOT=1
# ORCHESTRATOR_DESKTOP_AX=1
# ORCHESTRATOR_DESKTOP_TEXT_CHARS=12000
# ORCHESTRATOR_DESKTOP_AX_CHARS=8000
# After each computer-agent task, ask "Did that work?" and log feedback with goal + actions.
# TASK_FEEDBACK=1
# read_screen tool always captures display + AX + screenshot (on demand).
# Vision model for "save the screen as memory" (defaults to ORCHESTRATOR_MODEL)
# MEMORY_VISION_MODEL=gpt-4o-mini
# After each voice / computer-use run, extract durable facts (repos, songs, …)
MEMORY_EXTRACT=1
# MEMORY_EXTRACT_MODEL=gpt-5-mini
# After extract/save, rewrite memory files to drop duplicate bullets (background).
MEMORY_CONDENSE=1
# MEMORY_CONDENSE_MODEL=gpt-5-mini

# =============================================================================
# Passive observer (cua observe) — drafts only; accept to write memory/skills
# =============================================================================
# OBSERVE=1
# Flush a session screenshot after this many seconds without click/scroll
# OBSERVE_IDLE_SECONDS=3
# Accumulate captures this long before extracting a draft (default 10 minutes)
# OBSERVE_DRAFT_SECONDS=600
# OBSERVE_MAX_SHOTS_PER_HOUR=40
# OBSERVE_EXTRACT_MODEL=gpt-5-mini

# Force one computer-agent model (skips difficulty router when set)
# AGENT_MODEL=gpt-5.6

# Difficulty router (AGENT_ROUTE=0 to disable and use AGENT_MODEL_HARD)
AGENT_ROUTE=1
ROUTER_MODEL=gpt-5-mini
AGENT_MODEL_EASY=gpt-5.6-luna
AGENT_MODEL_MEDIUM=gpt-5.6-terra
AGENT_MODEL_HARD=gpt-5.6
# Step budget from the same difficulty class (easy / medium / hard)
# AGENT_STEPS_EASY=25
# AGENT_STEPS_MEDIUM=100
# AGENT_STEPS_HARD=200

# N-step coach during computer-agent runs (0 = disable)
EVAL_EVERY=5
EVAL_MODEL=gpt-5-mini

# Parameterized open_url / open_app prefixes; leftover work still uses computer-use.
RECIPE_REPLAY=1
RECIPE_RECORD=1
# RECIPE_SETTLE_SEC=0.8
# RECIPE_AUTO_SAVE=1
# Fill {{placeholders}} with EVAL_MODEL only if regex bind fails.
RECIPE_LLM_FILL=1

# =============================================================================
# Wake word
# =============================================================================
# model  = openWakeWord ONNX (offline)
# phrase = match any WAKE_PHRASE via STT (uses API; barge-in disabled)
WAKE_MODE=model

# Pretrained aliases: hey_jarvis, alexa, hey_mycroft, hey_rhasspy, timer, weather
# Or path to a custom .onnx (comma-separated for multiple)
# Comma-separated aliases, filenames, or paths
WAKE_MODEL=hey_jarvis,Hey_Rekha.onnx
# Comma-separated spoken forms (longest match wins when stripping from STT).
WAKE_PHRASE=Hey Jarvis,Hey Rekh

# Directory for ONNX assets (auto-downloaded)
# WAKE_MODEL_DIR=./models/wake

WAKE_THRESHOLD=0.5
# Sleep mode ignores the wake word (cua sleep on / menu / ⌘⌥S). Face = sleep vs wink.
# SLEEP_MODE=0
WAKE_BARGE_THRESHOLD=0.6
# While listening, say this closer to send (stripped from the command).
# Default: "over and out" (also matches "over n out" / "over & out").
WAKE_END_PHRASE=over and out,over n out
# ONNX stop-word scored on the STT mic stream. Bundled file is used if present.
WAKE_END_MODEL=over_and_out.onnx
# WAKE_END_LISTEN=1
# WAKE_END_LIVE_STT=1
# WAKE_END_LISTEN_IGNORE=0.25
WAKE_CHIME=0
# Tink on wake-detect if WAKE_CHIME=1; also played when over and out ends a listen.
# WAKE_CHIME_SOUND=/System/Library/Sounds/Tink.aiff
# Cue when the STT mic is actually open (idle, mid-task, barge-in, ask_user).
STT_START_CHIME=1
# STT_START_CHIME_SOUND=/System/Library/Sounds/Ping.aiff
# Cue when listening stops (before "I heard: …" TTS). Distinct from wake chime.
STT_END_CHIME=1
# STT_END_CHIME_SOUND=/System/Library/Sounds/Pop.aiff

# =============================================================================
# Speech — STT / TTS / mic
# =============================================================================
# Providers: stt/openai.py, stt/sarvam.py, stt/whisperflow.py
# openai = OpenAI Realtime streaming (default)
# sarvam = Sarvam Saaras file STT (record until silence, then upload)
# whisperflow = local Whisper (mlx-whisper / faster-whisper / WHISPERFLOW_URL)
STT_PROVIDER=openai
# OpenAI live model (when STT_PROVIDER=openai)
STT_MODEL=gpt-live-transcribe
STT_IDLE_SECONDS=6
# After over-and-out / Send, close the realtime socket within this many seconds
# so listen cannot hang waiting for input_audio_buffer.completed.
# STT_END_FINISH_SECONDS=1.5
# While listening (terminal focused): Esc cancels without processing; Enter sends.
# STT_CANCEL_KEYS=esc
# STT_SEND_KEYS=enter
STT_NOISE_REDUCTION=far_field
# near_field | far_field | none (or empty)
STT_HIGHPASS_HZ=140
STT_VAD_THRESHOLD=0.55
# Per-step wall clock + duration on stdout and stt_latency.log (0 to disable).
STT_TIMING=1

# Local WhisperFlow (when STT_PROVIDER=whisperflow). Audio stays on-device.
# Uses a complete mlx-whisper snapshot when present; otherwise openai-whisper
# from ~/.cache/whisper (small.en). Incomplete HF downloads are skipped.
# STT_PROVIDER=whisperflow
# WHISPERFLOW_MODEL=small.en
# WHISPERFLOW_WHISPER_MODEL=small.en
# WHISPERFLOW_LANGUAGE=en
# WHISPERFLOW_BACKEND=auto
# auto | mlx | whisper | faster-whisper | http
# Optional OpenAI-compatible local server (whisper-local --serve, etc.)
# WHISPERFLOW_URL=http://127.0.0.1:7777/v1
# WHISPERFLOW_API_KEY=local
# WHISPERFLOW_FASTER_MODEL=small.en

# =============================================================================
# Fn-key dictation (live-paste speech into the focused field)
# =============================================================================
# Starts with the orchestrator when DICTATION=1 (macOS only).
# Hold Fn (no ⌘⌥⌃⇧) while a text field is focused → Realtime STT →
# paste partials as you speak; release to send. Face overlay uses listen mood
# while the mic is open. Esc cancels; Fn again while listening cancels.
# Needs Accessibility permission.
DICTATION=1
# DICTATION_IDLE_SECONDS=2
# Batch rapid STT deltas before paste (seconds).
# DICTATION_PASTE_DEBOUNCE=0.08
# Swallow Globe/Fn (keycode 63) at the HID tap so emoji / character viewer
# does not also open. Needs Accessibility + Input Monitoring.
# DICTATION_SWALLOW=1
# Refuse unless AX says the focus is a text field (off = try paste anyway).
# DICTATION_REQUIRE_EDITABLE=0
# Dots near the cursor while Fn is held; circular spinner after release
# until transcription finishes.
# DICTATION_OVERLAY=1

# Sarvam Saaras (when STT_PROVIDER=sarvam)
# SARVAM_API_KEY=sk_...
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_MODE=transcribe
# transcribe | translate | verbatim | translit | codemix
# SARVAM_STT_LANGUAGE=unknown
# unknown = auto-detect; or e.g. en-IN, hi-IN

# Used only if refine/judge paths are enabled in code paths that call them
STT_REFINE_MODEL=gpt-4o-transcribe
STT_JUDGE_MODEL=gpt-5-mini

# Speaker recognition (enroll with: cua speaker enroll --name YourName)
# Uses speakeronnx / WeSpeaker ECAPA ONNX embeddings (not MFCC).
# Enrollment: 3 long passages + 2 short phrases ("Hey Jarvis", "Yes, go ahead").
# SPEAKER_ID=1
# SPEAKER_ID_MODEL=wespeaker-ecapa512
# SPEAKER_ID_THRESHOLD=0.55
# SPEAKER_ID_SHORT_THRESHOLD=0.35
# SPEAKER_ID_SHORT_THRESHOLD_FLOOR=0.30
# SPEAKER_ID_SHORT_SECONDS=4.0
# SPEAKER_ID_LOOP_BELOW_SECONDS=2.0
# SPEAKER_ID_TRIM_DB=25
# SPEAKER_ID_MARGIN=0.08

# After listening ends, speak one short line restating the transcript ("I heard: …").
# 1 / true / on = speak it. 0 / false / no / off = skip (lower latency).
TTS_CONFIRM_HEARD=1
# Interrupt TTS (sync + streaming) when the wake word is heard.
# Opens the mic during speech — may hiss on some Macs; set 0 to disable.
TTS_BARGE_IN=1
# Stop TTS with Space / Esc / Enter in the orchestrator terminal, then listen.
TTS_KEYBOARD_BARGE=1
# TTS_KEYBOARD_BARGE_KEYS=space,esc,enter
# After barge-in during give_response, classify whether the user redirected to a
# new computer task (starts agent immediately) vs answered a question (LLM continues).
# BARGE_CLASSIFY=1
# BARGE_CLASSIFY_MODEL=gpt-5-mini
# openai = OpenAI gpt-4o-mini-tts (default)
# sarvam = Bulbul HTTP streaming TTS (needs SARVAM_API_KEY)
# piper  = local Piper ONNX (pip install piper-tts; voices in models/piper/)
# kokoro = local Kokoro (pip install mlx-audio on Mac, or KOKORO_ONNX_MODEL)
# Providers: tts/openai.py, tts/sarvam.py, tts/piper.py, tts/kokoro.py
# Console [tts] chatter (spoken text, provider, barge). Off by default.
# TTS_LOG=0
# Console [tts-latency] timing lines. Off by default (file log still written).
# TTS_LATENCY_LOG=0
TTS_PROVIDER=openai
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_VOICE=shubh
# TTS_VOICE_JARVIS=shubh
# TTS_VOICE_REKHA=priya
# SARVAM_TTS_LANGUAGE=en-IN
# SARVAM_TTS_SAMPLE_RATE=24000
# TTS_VOICE=               # optional override (onyx / shubh / piper voice / kokoro voice)
# Local Piper
# TTS_PROVIDER=piper
# PIPER_VOICE=en_GB-alan-medium
# PIPER_DIR=models/piper
# PIPER_MODEL=                 # optional path to a .onnx (skips download)
# PIPER_LENGTH_SCALE=1.0
# Local Kokoro (Apple Silicon mlx-audio)
# TTS_PROVIDER=kokoro
# KOKORO_VOICE=bm_george
# KOKORO_MODEL=mlx-community/Kokoro-82M-bf16
# KOKORO_SPEED=1.0
# KOKORO_LANG=                 # default from voice prefix (bm_ → British)
# KOKORO_ONNX_MODEL=           # optional kokoro-onnx .onnx instead of mlx
# KOKORO_ONNX_VOICES=
# TTS_PLAYER=afplay          # macOS default; use sounddevice to force PortAudio
# Tell the computer-use agent only whether media is playing (Music/Spotify yes|no).
# Not Jarvis TTS; browser YouTube is not probed.
# SPEAKER_OUTPUT_FEEDBACK=1
# SPEAKER_OUTPUT_PROBE_TTL=1.5
# TTS_FADE_MS=8

# Stream Responses API partial give_response_to_user args into chunked TTS
# (synthesis + playback workers). Set 0 to use synchronous speak() only.
TTS_STREAM=1
# Clause size before a chunk is synthesized (lower = sooner first audio)
TTS_CHUNK_MIN_CHARS=20
TTS_CHUNK_MAX_CHARS=100
# Warm TTS (DNS/TLS + one short synth) when the orchestrator starts
TTS_WARMUP=1
# Latency markers: project-root tts_latency.log (response_ready, first_audio_play)

# sounddevice input device index or name (empty = default)
# MIC_DEVICE=

# =============================================================================
# Skills
# =============================================================================
# After a completed run, auto-save a new skill when the reviewer recommends one
SKILL_AUTO_SAVE=1
# Manual rewrite of verbose skills/*/SKILL.md (not run automatically):
#   cua skills condense
#   cua skills condense --name open-app --dry-run
#   cua skills merge --dry-run
#   cua skills merge
# SKILL_CONDENSE_MODEL=gpt-5-mini
# SKILL_CONDENSE_MIN_CHARS=1800

# =============================================================================
# Menu-bar status (macOS)
# =============================================================================
STATUS_TRAY=1
STATUS_TRAY_POLL=0.75
STATUS_LOG_LINES=40
# Top-center blobatar-style face (capsule eyes). Hidden from CU screenshots.
FACE_OVERLAY=1
# FACE_OVERLAY_PRESET=pebble
# pebble | droplet | cloud | sun, or any other name (hashed blobatar)
# e.g. FACE_OVERLAY_PRESET=jarvis   (or: cua face jarvis)
# FACE_OVERLAY_WIDTH=128
# FACE_OVERLAY_HEIGHT=128
# FACE_OVERLAY_MARGIN_TOP=10
# FACE_OVERLAY_FPS=20
# FACE_OVERLAY_HUE=198
# Floating chat window (Screenshot toggle on by default). Off until you
# cua chat on / menu-bar Chat / ⌘⌥C, or set CHAT_OVERLAY=1.
# History: .runtime/chat/chats.sqlite3 + screenshots/ (or CHAT_DATA_DIR).
# CHAT_OVERLAY=0
# CHAT_MODEL=gpt-4o-mini
# Model popup default: openai | deepseek (also saved in SQLite prefs).
# CHAT_BACKEND=openai
# Extra models (comma-separated provider:model):
# CHAT_MODELS=openai:gpt-4.1,deepseek:deepseek-v4-flash-vision-exp
# CHAT_DEEPSEEK_MODEL=deepseek-v4-pro
# CHAT_DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Window size (omit for ~55%×72% of the screen, min 720×480):
# CHAT_OVERLAY_WIDTH=960
# CHAT_OVERLAY_HEIGHT=640
# CHAT_SIDEBAR_WIDTH=220
# CHAT_DATA_DIR=
# Computer-use screenshots include every monitor (labeled screen N). Set 0 for primary-only.
# CU_ALL_DISPLAYS=1
# Opt-in LAN/Tailscale HTTP gateway for a companion phone app (off by default).
# Same Wi-Fi or Android hotspot works on-LAN; use Tailscale when the phone is on
# cellular or iPhone Personal Hotspot (often blocks LAN to the Mac).
# PHONE_GATEWAY=1 python orchestrator.py --auto
# Startup prints LAN + Tailscale (100.x) + MagicDNS URLs when tailscale CLI is installed.
PHONE_GATEWAY=1
# PHONE_GATEWAY_HOST=0.0.0.0
# PHONE_GATEWAY_PORT=8742
# PHONE_GATEWAY_TOKEN=   # optional, max 5 chars; otherwise .runtime/phone.token is created
# Phone preview is the last computer-use screenshot (JPEG, not a live stream).
# PHONE_SCREEN_MAX_WIDTH=1080
# PHONE_SCREEN_QUALITY=60
# PHONE_AUDIO_MAX_BYTES=2500000
# Camera still from the phone (JPEG/PNG/HEIC). Jarvis explains it / answers follow-ups.
# PHONE_PHOTO_MAX_BYTES=6000000
# PHONE_PHOTO_MAX_WIDTH=1280
# PHONE_PHOTO_QUALITY=70
# PHONE_PHOTO_TTL_SEC=1800
# Latest Mac TTS WAV for phone playback: GET /v1/speech when speech_at changes.

# =============================================================================
# MCP (optional tools without taking the desktop)
# =============================================================================
# Copy mcp.json.example → mcp.json, or log in:
#   cua mcp login linear
#   cua mcp login github
# Tokens are stored in .runtime/mcp-auth/ (not in .env).
# MCP_CONFIG=./mcp.json
# MCP_ENABLE=github,linear
# MCP_ORCHESTRATOR=1
# MCP_AGENT=1
# MCP_READ_ONLY=0
# MCP_MAX_OUTPUT=24000
# MCP_CONNECT_TIMEOUT=25
# MCP_CALL_TIMEOUT=60
# MCP_SERVERS={"mcpServers":{"echo":{"command":"python","args":["tests/fixtures/echo_mcp_server.py"]}}}

# =============================================================================
# Terminal tool (run_terminal)
# =============================================================================
TERMINAL_TIMEOUT=60
TERMINAL_MAX_OUTPUT=30000
# SHELL=/bin/zsh

# =============================================================================
# Accessibility (read_ui_text)
# =============================================================================
AX_MAX_NODES=400
AX_MAX_DEPTH=12
AX_MAX_CHARS=12000

# Live occupancy: running apps + Chrome/Safari/Brave/Edge tabs in the prompt
# DESKTOP_LIST_TABS=1
# DESKTOP_TAB_TIMEOUT=8
# CONTEXT_BUDGET_DISPLAYS=4500

# =============================================================================
# ZeroMQ bus (orchestrator ↔ computer agent)
# =============================================================================
# AGENT_BUS_ENDPOINT=ipc:///tmp/computer-use-agent-bus.ipc
# AGENT_BUS_ENDPOINT=tcp://127.0.0.1:5557
